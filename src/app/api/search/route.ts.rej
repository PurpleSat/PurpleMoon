--- src/app/api/search/route.ts
+++ src/app/api/search/route.ts
@@ -178,16 +293,183 @@
     );
   }
 
+  const cacheKey = query.toLowerCase();
+
+  // -----------------------------------------------------------------------
+  // 1. 流式响应模式 (SSE: text/event-stream) - 边搜边返回
+  // -----------------------------------------------------------------------
+  if (isStream) {
+    const encoder = new TextEncoder();
+    const stream = new ReadableStream({
+      async start(controller) {
+        let isClosed = false;
+        const safeClose = () => {
+          if (!isClosed) {
+            isClosed = true;
+            try {
+              controller.close();
+            } catch {}
+          }
+        };
+
+        const sendEvent = (eventData: any) => {
+          if (isClosed) return;
+          try {
+            controller.enqueue(encoder.encode(`data: ${JSON.stringify(eventData)}\n\n`));
+          } catch {
+            isClosed = true;
+          }
+        };
+
+        try {
+          // 检查服务端缓存
+          const cached = getSearchCache(cacheKey);
+          if (cached) {
+            sendEvent({
+              type: 'start',
+              totalSites: cached.groupedBySource.length,
+              fromCache: true,
+            });
+
+            for (const group of cached.groupedBySource) {
+              sendEvent({
+                type: 'chunk',
+                source: group.source,
+                sourceName: group.sourceName,
+                results: group.results,
+              });
+            }
+
+            sendEvent({
+              type: 'done',
+              totalResults: cached.results.length,
+              fromCache: true,
+              timeMs: 0,
+            });
+
+            safeClose();
+            return;
+          }
+
+          let apiSites: ApiSite[] = [];
+          try {
+            apiSites = await getAvailableApiSites();
+          } catch {
+            sendEvent({ type: 'error', message: '获取视频源失败' });
+            safeClose();
+            return;
+          }
+
+          sendEvent({
+            type: 'start',
+            totalSites: apiSites.length,
+            fromCache: false,
+          });
+
+          const groupedBySource: SourceGroup[] = [];
+          const startTime = Date.now();
+
+          const allResults = await runSearchWithPool({
+            sites: apiSites,
+            query,
+            clientSignal: request.signal,
+            onResult: (site, results) => {
+              groupedBySource.push({
+                source: site.key,
+                sourceName: site.name,
+                results,
+              });
+              sendEvent({
+                type: 'chunk',
+                source: site.key,
+                sourceName: site.name,
+                results,
+              });
+            },
+            onProgress: (completed, total) => {
+              sendEvent({
+                type: 'progress',
+                completed,
+                total,
+              });
+            },
+          });
+
+          // 写入服务端内存短时缓存
+          setSearchCache(cacheKey, {
+            results: allResults,
+            groupedBySource,
+          });
+
+          const elapsed = Date.now() - startTime;
+          sendEvent({
+            type: 'done',
+            totalResults: allResults.length,
+            fromCache: false,
+            timeMs: elapsed,
+          });
+        } catch {
+          sendEvent({ type: 'error', message: '搜索发生异常' });
+        } finally {
+          safeClose();
+        }
+      },
+    });
+
+    return new Response(stream, {
+      headers: {
+        'Content-Type': 'text/event-stream; charset=utf-8',
+        'Cache-Control': 'no-cache, no-transform',
+        'Connection': 'keep-alive',
+        'X-Accel-Buffering': 'no',
+      },
+    });
+  }
+
+  // -----------------------------------------------------------------------
+  // 2. 传统 JSON 模式（兼容旧版接口与单源匹配需求）
+  // -----------------------------------------------------------------------
   try {
+    const cached = getSearchCache(cacheKey);
+    if (cached) {
+      return NextResponse.json(
+        { results: cached.results },
+        {
+          headers: {
+            'X-Cache': 'HIT',
+            'Cache-Control': 'public, max-age=300',
+          },
+        }
+      );
+    }
+
     const apiSites = await getAvailableApiSites();
-    const flattenedResults = await batchSearch(apiSites, query, 2);
-    const cacheTime = await getCacheTime();
+    const groupedBySource: SourceGroup[] = [];
+
+    const allResults = await runSearchWithPool({
+      sites: apiSites,
+      query,
+      clientSignal: request.signal,
+      onResult: (site, results) => {
+        groupedBySource.push({
+          source: site.key,
+          sourceName: site.name,
+          results,
+        });
+      },
+    });
+
+    setSearchCache(cacheKey, {
+      results: allResults,
+      groupedBySource,
+    });
 
     return NextResponse.json(
-      { results: flattenedResults },
+      { results: allResults },
       {
         headers: {
-          'Cache-Control': `public, max-age=${cacheTime}`,
+          'X-Cache': 'MISS',
+          'Cache-Control': 'public, max-age=300',
         },
       }
     );
